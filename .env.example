APP_NAME="EmitirAgora"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Em produção: https://app.emitiragora.com.br. O domínio nu passou a ser o
# site institucional (projeto site-emitiragora), não este sistema.

# Domínio do produto. Decide o que é apresentação e o que é aplicação, e quais
# hosts não pertencem a tenant nenhum. Em desenvolvimento use o mesmo host que
# o `artisan serve` responde.
PRODUTO_DOMINIO=emitiragora.com.br

# Domínio do Nodo, produto à parte do sistema fiscal. Vazio desliga
# routes/api_plataforma.php inteiro: nenhuma rota casa com host nenhum.
API_DOMINIO=nodo.dev.br

# Gateway de WhatsApp do módulo WhatsApp do Painel API. AdminToken é da
# conta uazapi inteira; vazio desliga o módulo (nenhuma chamada à rede).
UAZAPI_URL=
UAZAPI_ADMIN_TOKEN=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Responsável técnico da NF-e (grupo infRespTec).
# Identifica a software house perante a SEFAZ. Obrigatório antes de emitir em produção.
FISCAL_RESP_TEC_CNPJ=
FISCAL_RESP_TEC_CONTATO=
FISCAL_RESP_TEC_EMAIL=
FISCAL_RESP_TEC_TELEFONE=

# Disco do material fiscal. No Laravel Cloud o filesystem é efêmero: use s3.
FISCAL_DISK_DRIVER=local

# Token opcional da API Comercial da ReceitaWS. Sem ele a consulta vai para a
# API Pública: 3 por minuto por IP, e só CNPJ que já está no banco deles.
RECEITAWS_TOKEN=
# Só na API Comercial: idade máxima, em dias, do dado devolvido do cache da
# ReceitaWS antes de consultar a Receita Federal de novo.
RECEITAWS_DIAS=30

# Para onde a venda-redonda avisa cada cadastro novo. Vazio desliga o envio.
ADMIN_PESSOAL_URL=
ADMIN_PESSOAL_TOKEN=

# Mesmo pixel e conta de anúncios do projeto Marcelo Andrade. Vazio desliga o
# pixel no navegador e o envio pela Conversions API.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Web service do SIGISS de Araras. Só preencha para apontar para outro host;
# os padrões de homologação e produção já estão em config/nfse.php.
# SIGISS_HOMOLOGACAO_URL=
# SIGISS_PRODUCAO_URL=
